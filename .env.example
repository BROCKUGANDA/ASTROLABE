# ASTROLABE environment. Copy to .env and edit.
# The prototype runs with defaults; nothing here is a real credential.

# SQLite file for the Prisma layer. The product's source of truth is the
# append-only event log the engine replays; this keeps /api/readyz honest.
DATABASE_URL=file:../db/custom.db

# Signs session cookies. REQUIRED to run `bun run start`: the session layer refuses
# to self-assign a production key, so sign-in returns 500 until this is set.
# Generate one: openssl rand -hex 32
SESSION_SECRET=change-me-to-at-least-32-characters

# Separate, revocable keys for the two privileged consoles (admin, judge mode).
# Outside production they fall back to documented dev values so a clone can demo.
ASTROLABE_ADMIN_TOKEN=
ASTROLABE_JUDGE_KEY=

# Off = the frozen demo clock the synthetic pack describes (2024-10-19).
# 1 = read the real wall clock, for a deployment against live data.
ASTROLABE_LIVE_CLOCK=0

# Public origin of THIS deployment. It is not a secret and it is not cosmetic:
# canonical URLs, the sitemap, robots' Sitemap: line, Open Graph URLs and the
# structured data are all resolved against it. Leaving it unset means the live
# host (https://astrolabe.svalley.tech); set it for a local or preview deploy so
# crawlers are not told a localhost page canonically lives somewhere else.
SITE_URL=
